<Window x:Class="FoulzExternal.logging.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AARDVARK DEBUG" Height="420" Width="640"
        Background="Transparent" Foreground="#EEE"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Opacity="0.98">

	<Window.Resources>
		<Style x:Key="GlowClose" TargetType="Button">
			<Setter Property="Background" Value="#1E1E22"/>
			<Setter Property="Foreground" Value="#767680"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#525258" BorderThickness="0.5">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="b" Property="Background" Value="#242830"/>
								<Setter TargetName="b" Property="BorderBrush" Value="#587892"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border BorderBrush="#76D0F2" BorderThickness="0.8" Background="#0F0F0F" CornerRadius="9" Padding="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="40"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Header (Yerba-style) -->
			<Border Grid.Row="0" MouseLeftButtonDown="move_it" CornerRadius="8,8,0,0" Background="#111116">
				<Grid>
					<TextBlock Text="DEBUG CONSOLE" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" FontWeight="Bold"
					           Foreground="#76D0F2"/>
					<Button Content="✕" HorizontalAlignment="Right" Width="30" Height="26"
                            Style="{StaticResource GlowClose}" Click="bye" Margin="0,0,8,0"/>
				</Grid>
			</Border>

			<!-- Dot-pattern body -->
			<Border Grid.Row="1" CornerRadius="0,0,8,8" Background="#0A0A0A">
				<Grid>
					<Canvas IsHitTestVisible="False" Opacity="0.6">
						<Canvas.Background>
							<DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
								<DrawingBrush.Drawing>
									<GeometryDrawing Brush="#303036">
										<GeometryDrawing.Geometry>
											<EllipseGeometry Center="0,0" RadiusX="0.9" RadiusY="0.9"/>
										</GeometryDrawing.Geometry>
									</GeometryDrawing>
								</DrawingBrush.Drawing>
							</DrawingBrush>
						</Canvas.Background>
					</Canvas>
					<ScrollViewer x:Name="scroller" Margin="4" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
						<StackPanel x:Name="console_out" Background="Transparent"/>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>
	</Border>
</Window>