<UserControl x:Class="FoulzExternal.features.games.universal.explorer.ExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="hdr_grad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="White" Offset="0"/>
            <GradientStop Color="#BFC3C6" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TreeViewItem" x:Key="tree_style">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1AFF4FA3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0DFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="MenuItem" x:Key="ctx_item">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#111" BorderThickness="1" Background="#080808" CornerRadius="6" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Border Background="#0B0B0B" CornerRadius="4" Padding="0,0,8,0">
                <DockPanel>
                    <TextBlock Text="INSTANCE EXPLORER" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource hdr_grad}"/>
                    <Button x:Name="btn_refresh" Content="⟳" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnRefresh_Click"
                        Background="Transparent" Foreground="#999" BorderThickness="0" FontSize="14" Cursor="Hand" Padding="6,2" ToolTip="Refresh tree"/>
                </DockPanel>
            </Border>

            <!-- Search bar -->
            <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#151515" BorderThickness="1" CornerRadius="4" Margin="0,5,0,0" Padding="6,4">
                <DockPanel>
                    <TextBlock Text="🔍" Foreground="#555" FontSize="11" VerticalAlignment="Center" Margin="4,0,6,0"/>
                    <TextBox x:Name="searchBox"
                             Text="" 
                             FontSize="10" Foreground="#AAA" Background="Transparent"
                             BorderThickness="0" Padding="2,0"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Foreground" Value="#444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </DockPanel>
            </Border>

            <!-- Main content: tree + properties -->
            <Grid Grid.Row="2" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Tree view -->
                <Border Grid.Column="0" Background="#070707" CornerRadius="4" BorderBrush="#111" BorderThickness="1">
                    <ScrollViewer x:Name="treeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  CanContentScroll="False" PanningMode="Both" Padding="2">
                        <TreeView x:Name="tree" Background="Transparent" BorderThickness="0"
                                  ItemContainerStyle="{StaticResource tree_style}"
                                  PreviewMouseWheel="Tree_PreviewMouseWheel"/>
                    </ScrollViewer>
                </Border>

                <!-- Properties panel -->
                <Border Grid.Column="1" Background="#0A0A0A" CornerRadius="6" Padding="10" Margin="8,0,0,0"
                        BorderBrush="#111" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" PanningMode="VerticalOnly">
                        <StackPanel>
                            <TextBlock Text="Properties" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" FontSize="12"/>

                            <!-- Name -->
                            <Border Background="#0D0D0D" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name" Foreground="#777" FontSize="9"/>
                                    <TextBlock Grid.Column="1" x:Name="p_name" Text="-" Foreground="White" FontSize="9" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <!-- Class -->
                            <Border Background="#0D0D0D" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Class" Foreground="#777" FontSize="9"/>
                                    <TextBlock Grid.Column="1" x:Name="p_class" Text="-" Foreground="#6BB3FF" FontSize="9" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <!-- Address -->
                            <Border Background="#0D0D0D" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Address" Foreground="#777" FontSize="9"/>
                                    <TextBlock Grid.Column="1" x:Name="p_addr" Text="-" Foreground="#FFD799" FontSize="9" FontFamily="Consolas"/>
                                </Grid>
                            </Border>

                            <!-- Children -->
                            <Border Background="#0D0D0D" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Children" Foreground="#777" FontSize="9"/>
                                    <TextBlock Grid.Column="1" x:Name="p_children" Text="-" Foreground="White" FontSize="9"/>
                                </Grid>
                            </Border>

                            <!-- Health -->
                            <Border Background="#0D0D0D" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Health" Foreground="#777" FontSize="9"/>
                                    <TextBlock Grid.Column="1" x:Name="p_hp" Text="-" Foreground="White" FontSize="9"/>
                                </Grid>
                            </Border>

                            <!-- Position -->
                            <Border Background="#0D0D0D" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Position" Foreground="#777" FontSize="9"/>
                                    <TextBlock Grid.Column="1" x:Name="p_pos" Text="-" Foreground="White" FontSize="9"/>
                                </Grid>
                            </Border>

                            <!-- Flagged -->
                            <Border Background="#0D0D0D" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Flagged" Foreground="#777" FontSize="9"/>
                                    <TextBlock Grid.Column="1" x:Name="p_flagged" Text="-" FontSize="9"/>
                                </Grid>
                            </Border>

                            <!-- Teleport button -->
                            <Button x:Name="btn_teleport" Content="📌 Teleport Here" Visibility="Collapsed" Click="BtnTeleport_Click"
                                    Background="#1A1A1A" Foreground="White" BorderBrush="#333" Padding="8,4" Margin="0,6" Cursor="Hand"
                                    FontSize="10" HorizontalContentAlignment="Center"/>

                            <!-- ProximityPrompt -->
                            <StackPanel x:Name="pnl_proximity" Visibility="Collapsed" Margin="0,4">
                                <Border Background="#0D0D0D" CornerRadius="3" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="Hold Duration" Foreground="#777" FontSize="9" Margin="0,0,0,4"/>
                                        <Slider x:Name="sld_hold" Minimum="0" Maximum="10" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                ValueChanged="SldHold_ValueChanged" Margin="0,2"/>
                                        <TextBlock x:Name="txt_hold" Text="0.0s" Foreground="White" FontSize="9" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Separator Background="#222" Margin="0,6"/>

                            <!-- Attributes section -->
                            <TextBlock Text="Attributes" FontWeight="Bold" Foreground="White" Margin="0,4,0,8" FontSize="12"/>
                            <TextBlock x:Name="p_attrs_none" Text="No attributes" Foreground="#444" FontSize="9" FontStyle="Italic"/>
                            <StackPanel x:Name="p_attrs_list"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>